def clamp(v):
    return 0 if v < 0 else 248 if v > 248 else int(v) & 0xF8


def rgb(r, g, b):
    return (clamp(r), clamp(g), clamp(b))


def mix(a, b, t):
    return rgb(a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t)


def hsv(h, s=1.0, v=1.0):
    h = (h % 1.0) * 6
    i = int(h)
    f = h - i
    p, q, t = v * (1 - s), v * (1 - s * f), v * (1 - s * (1 - f))
    r, g, b = [(v, t, p), (q, v, p), (p, v, t), (p, q, v), (t, p, v), (v, p, q)][i % 6]
    return rgb(r * 255, g * 255, b * 255)


class Screen:
    def __init__(self):
        cols, rows = shutil.get_terminal_size((100, 30))
        self.W = max(40, min(cols, 170))
        self.rows = max(12, min(rows - 1, 52))
        self.ox = max(0, (cols - self.W) // 2)
        self.oy = max(0, (rows - 1 - self.rows) // 2)
        self.H = self.rows * 2
        self.fb = [[BLACK] * self.W for _ in range(self.H)]
        self.last = time.time()

    def gradient(self, top, bottom):
        H = self.H
        self.fb = [[mix(top, bottom, y / (H - 1))] * self.W for y in range(H)]

    def fill(self, c):
        self.fb = [[c] * self.W for _ in range(self.H)]

    def snapshot(self):
        return [row[:] for row in self.fb]

    def restore(self, snap):
        self.fb = [row[:] for row in snap]

    def px(self, x, y, c):
        x, y = int(x), int(y)
        if 0 <= x < self.W and 0 <= y < self.H:
            self.fb[y][x] = c

    def blend(self, x, y, c, a):
        x, y = int(x), int(y)
        if 0 <= x < self.W and 0 <= y < self.H:
            self.fb[y][x] = mix(self.fb[y][x], c, a)

    def rect(self, x0, y0, x1, y1, c):
        x0, x1 = max(0, int(x0)), min(self.W, int(x1))
        y0, y1 = max(0, int(y0)), min(self.H, int(y1))
        if x0 >= x1:
            return
        seg = [c] * (x1 - x0)
        for y in range(y0, y1):
            self.fb[y][x0:x1] = seg

    def disc(self, cx, cy, r, c):
        for y in range(int(cy - r), int(cy + r) + 1):
            dy = y + 0.5 - cy
            w = r * r - dy * dy
            if w > 0:
                w = math.sqrt(w)
                self.rect(cx - w, y, cx + w, y + 1, c)

    def ring(self, cx, cy, rx, ry, c, th=1.5, a=1.0):
        n = max(16, int((rx + ry) * 4))
        for i in range(n):
            ang = 2 * math.pi * i / n
            ca, sa = math.cos(ang), math.sin(ang)
            d = 0.0
            while d <= th:
                x, y = cx + ca * (rx + d), cy + sa * (ry + d)
                if a >= 1:
                    self.px(x, y, c)
                else:
                    self.blend(x, y, c, a)
                d += 0.8

    def line(self, x0, y0, x1, y1, c, th=1):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        for i in range(n + 1):
            t = i / n
            x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
            if th <= 1:
                self.px(x, y, c)
            else:
                self.rect(x - th / 2, y - th / 2, x + th / 2, y + th / 2, c)

    def tri(self, a, b, c, col):
        minx, maxx = max(0, int(min(a[0], b[0], c[0]))), min(self.W - 1, int(max(a[0], b[0], c[0])) + 1)
        miny, maxy = max(0, int(min(a[1], b[1], c[1]))), min(self.H - 1, int(max(a[1], b[1], c[1])) + 1)
        area = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
        if area == 0:
            return
        for y in range(miny, maxy + 1):
            py = y + 0.5
            row = self.fb[y]
            for x in range(minx, maxx + 1):
                px = x + 0.5
                w0 = (b[0] - a[0]) * (py - a[1]) - (b[1] - a[1]) * (px - a[0])
                w1 = (c[0] - b[0]) * (py - b[1]) - (c[1] - b[1]) * (px - b[0])
                w2 = (a[0] - c[0]) * (py - c[1]) - (a[1] - c[1]) * (px - c[0])
                if (w0 >= 0 and w1 >= 0 and w2 >= 0) or (w0 <= 0 and w1 <= 0 and w2 <= 0):
                    row[x] = col

    def text(self, s, cx, cy, scale, top, bottom, outline=BLACK, slice_dx=None):
        w = len(s) * 6 * scale - scale
        x0 = int(cx - w / 2)
        y0 = int(cy - 7 * scale / 2)
        o = max(1, scale // 2)
        for pass_ in ((0, 1) if outline is not None else (1,)):
            for i, ch in enumerate(s):
                glyph = FONT.get(ch, FONT[" "])
                for r, bits in enumerate(glyph):
                    for k, bit in enumerate(bits):
                        if bit != "1":
                            continue
                        gx = x0 + (i * 6 + k) * scale
                        gy = y0 + r * scale
                        for sy in range(scale):
                            yy = gy + sy
                            dx = slice_dx(yy) if slice_dx else 0
                            if pass_ == 0:
                                self.rect(gx - o + dx, yy - o, gx + scale + o + dx, yy + o + 1, outline)
                            else:
                                col = mix(top, bottom, (r * scale + sy) / (7 * scale))
                                self.rect(gx + dx, yy, gx + scale + dx, yy + 1, col)

    def present(self, dx=0, dy=0, ab=0):
        W, H, fb = self.W, self.H, self.fb
        blank = [BLACK] * W

        def sample(y):
            yy = y - dy
            if not 0 <= yy < H:
                return blank
            r = fb[yy]
            if dx > 0:
                r = [BLACK] * dx + r[: W - dx]
            elif dx < 0:
                r = r[-dx:] + [BLACK] * (-dx)
            if ab:
                r = [(r[max(0, x - ab)][0], r[x][1], r[min(W - 1, x + ab)][2]) for x in range(W)]
            return r

        parts = []
        for row in range(self.rows):
            top, bot = sample(row * 2), sample(row * 2 + 1)
            parts.append("\x1b[%d;%dH" % (row + 1 + self.oy, 1 + self.ox))
            fg = bg = None
            for x in range(W):
                t, b = top[x], bot[x]
                if t == b:
                    if b != bg:
                        parts.append("\x1b[48;2;%d;%d;%dm" % b)
                        bg = b
                    parts.append(" ")
                else:
                    if t != fg:
                        parts.append("\x1b[38;2;%d;%d;%dm" % t)
                        fg = t
                    if b != bg:
                        parts.append("\x1b[48;2;%d;%d;%dm" % b)
                        bg = b
                    parts.append("▀")
        sys.stdout.write("".join(parts))
        sys.stdout.flush()
        now = time.time()
        wait = 1 / FPS - (now - self.last)
        if wait > 0:
            time.sleep(wait)
        self.last = time.time()



class Particles:
    def __init__(self):
        self.items = []

    def burst(self, x, y, n, speed, colors, life=(15, 35), grav=0.15, size=(1, 2)):
        for _ in range(n):
            a = random.uniform(0, 2 * math.pi)
            sp = random.uniform(0.2, 1.0) * speed
            self.items.append([x, y, math.cos(a) * sp, math.sin(a) * sp * 0.8,
                               random.randint(*life), random.choice(colors), grav,
                               random.randint(*size)])

    def add(self, x, y, vx, vy, life, col, grav=0.0, size=1):
        self.items.append([x, y, vx, vy, life, col, grav, size])

    def step(self, scr, shift=0.0):
        keep = []
        for p in self.items:
            p[0] += p[2] - shift
            p[1] += p[3]
            p[3] += p[6]
            p[2] *= 0.97
            p[4] -= 1
            if p[4] > 0:
                keep.append(p)
                s = p[7] if p[4] > 6 else 1
                scr.rect(p[0], p[1], p[0] + s, p[1] + s, p[5])
        self.items = keep


def blend_disc(scr, cx, cy, r, col, a):
    for y in range(int(cy - r), int(cy + r) + 1):
        if not 0 <= y < scr.H:
            continue
        row = scr.fb[y]
        for x in range(int(cx - r), int(cx + r) + 1):
            if 0 <= x < scr.W:
                d = math.hypot(x - cx, y - cy)
                if d < r:
                    row[x] = mix(row[x], col, a * (1 - d / r) ** 2)


def vignette(scr, col, strength, power=2.0):
    W, H = scr.W, scr.H
    cx, cy = W / 2, H / 2
    m = math.hypot(cx, cy)
    for y in range(H):
        row = scr.fb[y]
        dy = (y - cy) ** 2
        for x in range(W):
            k = strength * (math.sqrt((x - cx) ** 2 + dy) / m) ** power
            if k > 0.02:
                row[x] = mix(row[x], col, min(1.0, k))


def frac(v):
    return v - math.floor(v)



def dim(c, k):
    return (min(248, int(c[0] * k)), min(248, int(c[1] * k)), min(248, int(c[2] * k)))


def light_pass(scr, k, skip=None):
    if k >= 0.999:
        return
    scr.fb = [[(int(p[0] * k), int(p[1] * k), int(p[2] * k)) for p in row] for row in scr.fb]


def text_mask(scr, s, cx, cy, sc):
    saved = scr.fb
    scr.fb = [[None] * scr.W for _ in range(scr.H)]
    scr.text(s, cx, cy, sc, WHITE, WHITE, outline=None)
    m = scr.fb
    scr.fb = saved
    return m


def drips_step(scr, drips, col, maxlen):
    for d in drips:
        d[2] = min(maxlen, d[2] + d[3])
        scr.rect(d[0], d[1], d[0] + 1, d[1] + d[2], mix(col, BLACK, 0.3))
        scr.rect(d[0] - 0.5, d[1] + d[2], d[0] + 1.5, d[1] + d[2] + 1.5, col)


BONE = (222, 212, 184)


def draw_hand(scr, bx, by, scale, curl, spread=1.0, ground=None):
    col, dark = BONE, (30, 24, 18)
    wrist = (bx, by)
    segs = []
    segs.append(((bx - scale * 0.12, by + scale * 1.4), (bx - scale * 0.06, by)))
    segs.append(((bx + scale * 0.12, by + scale * 1.4), (bx + scale * 0.07, by)))
    fingers = [(-1.0, 0.6), (-0.42, 0.9), (-0.12, 1.0), (0.18, 0.92), (0.48, 0.72)]
    joints = []
    for i, (ang, ln) in enumerate(fingers):
        a = -math.pi / 2 + ang * spread
        kd = scale * (0.3 if i == 0 else 0.46)
        knuckle = (bx + math.cos(a) * kd, by + math.sin(a) * kd)
        segs.append((wrist, knuckle))
        joints.append(knuckle)
        p = knuckle
        seg_len = scale * ln * 0.3 * (1 - 0.3 * curl)
        bend = (1 if ang < -0.12 else -1 if ang > -0.12 else 0)
        if i == 2:
            bend = 1
        for j in range(3):
            a += curl * 0.42 * bend
            q = (p[0] + math.cos(a) * seg_len, p[1] + math.sin(a) * seg_len)
            segs.append((p, q))
            joints.append(q)
            p = q
            seg_len *= 0.8 * (1 - 0.15 * curl)
    th = max(2, min(6, int(scale * 0.07)))
    for (a, b) in segs:
        scr.line(a[0], a[1], b[0], b[1], dark, th=th + 2)
    for (a, b) in segs:
        scr.line(a[0], a[1], b[0], b[1], col, th=th)
    for j in joints:
        scr.disc(j[0], j[1], th * 0.75, mix(col, WHITE, 0.2))
    scr.disc(wrist[0], wrist[1], th * 1.6, col)
    if ground is not None:
        scr.rect(bx - scale, ground, bx + scale, ground + 2, (40, 30, 20))


def ease(t):
    t = max(0.0, min(1.0, t))
    return t * t * (3 - 2 * t)


class Mirror:
    def __init__(self, scr):
        random.seed(3131)
        self.scr = scr
        W, H = scr.W, scr.H
        self.W, self.H = W, H
        mx0, mx1 = int(W * 0.27), int(W * 0.73)
        my0, my1 = int(H * 0.13), int(H * 0.74)
        self.m = (mx0, my0, mx1, my1)
        ts = max(5, int(H / 9))
        fb = []
        for y in range(H):
            row = []
            for x in range(W):
                if x % ts == 0 or y % ts == 0:
                    c = (70, 72, 68)
                else:
                    n = ((x // ts) * 7 + (y // ts) * 13) % 5
                    c = mix((176, 182, 176), (150, 156, 148), n / 5)
                    c = mix(c, (90, 84, 60), max(0.0, (y - H * 0.6) / H) * 0.9)
                    if math.sin(x * 0.4 + y * 0.9) * math.sin(x * 0.13 - y * 0.05) > 0.85:
                        c = mix(c, (70, 64, 44), 0.4)
                row.append(c)
            fb.append(row)
        scr.fb = fb
        scr.rect(mx0 - 2, my0 - 2, mx1 + 2, my1 + 2, (60, 60, 64))
        scr.rect(mx0 - 1, my0 - 1, mx1 + 1, my1 + 1, (120, 122, 128))
        bx0, bx1 = W * 0.3, W * 0.7
        by0 = H * 0.8
        for y in range(int(by0), H):
            for x in range(int(bx0), int(bx1)):
                t = (x - (bx0 + bx1) / 2) / ((bx1 - bx0) / 2)
                if abs(t) <= 1 - 0.15 * ((y - by0) / (H - by0)) ** 2:
                    shade = 0.75 + 0.25 * (1 - abs(t)) - 0.25 * ((y - by0) / (H - by0))
                    scr.px(x, y, mix((110, 112, 110), (226, 228, 224), shade))
        scr.rect(W * 0.3, by0, W * 0.7, by0 + 1, (240, 242, 238))
        scr.rect(W * 0.49, by0 - H * 0.05, W * 0.51, by0, (150, 152, 156))
        scr.rect(W * 0.47, by0 - H * 0.05, W * 0.53, by0 - H * 0.05 + 2, (170, 172, 176))
        self.room = scr.snapshot()
        refl = []
        for y in range(my0, my1):
            row = []
            for x in range(mx0, mx1):
                rx_ = mx0 + (x - mx0) * 0.85 + (mx1 - mx0) * 0.07
                c = self.room[min(H - 1, int(my0 * 0.4 + y * 0.9))][int(rx_)]
                c = mix(c, (20, 24, 26), 0.6)
                if x > mx0 + (mx1 - mx0) * 0.72 and y < my0 + (my1 - my0) * 0.85:
                    c = (12, 12, 14)
                row.append(c)
            refl.append(row)
        self.refl = refl
        self.fog = [[0.55 + 0.35 * (0.5 + 0.5 * math.sin(x * 0.21 + y * 0.13) * math.sin(x * 0.07 - y * 0.19))
                     for x in range(mx1 - mx0)] for y in range(my1 - my0)]
        self.clear = [[0.0] * (mx1 - mx0) for _ in range(my1 - my0)]
        mw, mh = mx1 - mx0, my1 - my0
        self.p1 = [(mx0 + mw * 0.32, my0 + mh * 0.42), (mx0 + mw * 0.45, my0 + mh * 0.66)]
        self.p2 = [(mx0 + mw * 0.45, my0 + mh * 0.66), (mx0 + mw * 0.72, my0 + mh * 0.22)]
        random.seed()

    def wipe(self, x, y, r=1.6):
        mx0, my0, mx1, my1 = self.m
        for yy in range(int(y - r - 1), int(y + r + 2)):
            for xx in range(int(x - r - 1), int(x + r + 2)):
                if mx0 <= xx < mx1 and my0 <= yy < my1:
                    d = math.hypot(xx + 0.5 - x, yy + 0.5 - y)
                    if d < r + 0.8:
                        v = 1.0 if d < r else 1 - (d - r) / 0.8
                        cl = self.clear[yy - my0]
                        cl[xx - mx0] = max(cl[xx - mx0], v)

    def stroke(self, pts, t, r=1.6):
        a, b = pts
        n = int(max(abs(b[0] - a[0]), abs(b[1] - a[1])) * 2) + 1
        for i in range(int(n * t) + 1):
            u = i / n
            self.wipe(a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u, r)

    def render(self, fog, light, f, tilt=0.0, grin=0.0, nod=0.0, sway=True, tint=None, cracks=None, crack_n=0, crack_col=(230, 236, 240), text_dark=False):
        scr, W, H = self.scr, self.W, self.H
        mx0, my0, mx1, my1 = self.m
        mw, mh = mx1 - mx0, my1 - my0
        fb = [row[:] for row in self.room]
        hx = mx0 + mw * 0.5 + (math.sin(f * 0.05) * 1.2 if sway else 0)
        hy = my0 + mh * 0.42 + nod * mh * 0.06
        hr = mh * 0.21
        ca, sa = math.cos(tilt), math.sin(tilt)
        fogc = (178, 184, 184)
        for y in range(my0, my1):
            rrow, frow, crow = self.refl[y - my0], self.fog[y - my0], self.clear[y - my0]
            out = fb[y]
            for x in range(mx0, mx1):
                c = rrow[x - mx0]
                dx, dy = x + 0.5 - hx, y + 0.5 - hy
                u = (dx * ca + dy * sa) / (hr * 0.82)
                v = (-dx * sa + dy * ca) / hr
                if u * u + v * v <= 1:
                    c = (12, 11, 12)
                    if grin > 0:
                        for ex in (-0.36, 0.36):
                            if (u - ex) ** 2 / 0.025 + (v + 0.12) ** 2 / 0.015 <= 1:
                                c = mix(c, (248, 244, 230), grin)
                        mv = 0.42 - 0.5 * u * u
                        if abs(u) < 0.75 and abs(v - mv) < 0.13 * grin + 0.01:
                            c = mix(c, (220, 214, 196) if int((u + 1) * 14) % 2 else (40, 10, 10), grin)
                    elif u * u + v * v > 0.8:
                        c = (30, 30, 32)
                else:
                    sdy = y + 0.5 - (my1 + mh * 0.12)
                    if (dx / (mw * 0.4)) ** 2 + (sdy / (mh * 0.42)) ** 2 <= 1 or (abs(dx) < hr * 0.42 and hy < y < my1):
                        c = (14, 13, 14)
                if text_dark and crow[x - mx0] > 0.5:
                    out[x] = (26, 0, 0)
                    continue
                a = frow[x - mx0] * fog * (1 - crow[x - mx0])
                if a > 0.01:
                    c = mix(c, fogc, min(0.95, a))
                out[x] = c
        scr.fb = fb
        if cracks:
            for pts in cracks:
                for j in range(min(crack_n, len(pts) - 1)):
                    scr.line(*pts[j], *pts[j + 1], crack_col)
                    scr.line(pts[j][0] + 1, pts[j][1], pts[j + 1][0] + 1, pts[j + 1][1], (40, 42, 46))
        light_pass(scr, light)
        if tint:
            col, ta = tint
            scr.fb = [[mix(p, col, ta) for p in row] for row in scr.fb]
        tx0, tx1, ty = W * 0.32, W * 0.68, my0 - max(3, H * 0.05)
        if light > 0.15:
            blend_disc(scr, W / 2, ty, W * 0.35, (230, 240, 236), 0.25 * light)
        scr.rect(tx0, ty, tx1, ty + 2, mix((70, 74, 72), (248, 248, 244), light))


MIRROR_REVEAL = 150


def mirror_light(f):
    n = math.sin(f * 78.233) * 43758.5453
    n -= math.floor(n)
    if f in (40, 41, 88, 89, 90, 131, 133):
        return 0.08
    if n < 0.08:
        return 0.35
    return 0.6 + 0.04 * math.sin(f * 2.7)


def mirror_intro(scr, mr):
    random.seed(6161)
    for f in range(MIRROR_REVEAL):
        fog = min(1.0, f / 70)
        if 95 <= f < 135:
            mr.stroke(mr.p1, (f - 95) / 40)
        mr.render(fog, mirror_light(f), f)
        scr.present()
    random.seed()


def mirror_win(scr, mr):
    mirror_intro(scr, mr)
    W, H = scr.W, scr.H
    for k in range(80):
        f = MIRROR_REVEAL + k
        if k < 24:
            mr.stroke(mr.p2, k / 23)
        fog = 1.0 if k < 32 else max(0.0, 1 - (k - 32) / 20)
        nod = math.sin(max(0.0, k - 48) * 0.35) * (1 if 48 <= k < 66 else 0)
        light = min(0.95, 0.6 + k * 0.008)
        warm = min(1.0, max(0.0, (k - 30) / 25))
        mr.render(fog, light, f, nod=nod, tint=((248, 236, 200), 0.12 * warm))
        if k > 60:
            blend_disc(scr, W / 2, H * 0.43, W * (0.2 + (k - 60) * 0.06), (240, 248, 226), min(1.0, (k - 60) * 0.06))
        scr.present()
    for k in range(6):
        scr.fill(mix((240, 248, 226), WHITE, k / 5))
        scr.present()
    time.sleep(0.15)


def mirror_lose(scr, mr):
    mirror_intro(scr, mr)
    W, H = scr.W, scr.H
    mx0, my0, mx1, my1 = mr.m
    cx, cy = (mx0 + mx1) / 2, (my0 + my1) * 0.47
    cracks = []
    for _ in range(11):
        a = random.uniform(0, 2 * math.pi)
        pts = [(cx, cy)]
        for j in range(7):
            a += random.uniform(-0.5, 0.5)
            r = (j + 1) * (mx1 - mx0) / 9
            px_, py_ = cx + math.cos(a) * r, cy + math.sin(a) * r * 0.8
            pts.append((max(mx0, min(mx1 - 1, px_)), max(my0, min(my1 - 1, py_))))
        cracks.append(pts)
    p = Particles()
    for k in range(62):
        f = MIRROR_REVEAL + k
        fog = max(0.25, 1 - k / 14)
        tilt = -0.45 * ease((k - 6) / 14)
        grin = ease((k - 16) / 10)
        light = mirror_light(f) if k < 30 else (0.75 if k % 4 < 2 else 0.18)
        crack_n = 0 if k < 30 else (k - 30) // 2 + 1
        mr.render(fog, light, f, tilt=tilt, grin=grin, sway=False, cracks=cracks, crack_n=crack_n)
        if k == 30:
            p.burst(cx, cy, 60, H * 0.05, [(220, 230, 236), (150, 160, 170)], life=(8, 20), grav=0.3, size=(1, 2))
        if k > 38:
            g = ease((k - 38) / 20)
            draw_hand(scr, cx, cy + H * 0.25 * (1 - g) + H * 0.1, H * (0.2 + 0.35 * g), 0.15 + 0.4 * g, spread=1.2)
        p.step(scr)
        s = 5 if k in (30, 31, 32) else (2 if k > 50 else 0)
        scr.present(random.randint(-s, s), random.randint(-s, s), 3 if k in (30, 31) else (2 if k > 54 else 0))
    for k in range(8):
        scr.fill(BLACK)
        scr.present()
    mr.clear = [[0.0] * len(row) for row in mr.clear]
    mw = mx1 - mx0
    sc = max(1, min(int(mw * 0.9 / 36), int((my1 - my0) * 0.6 / 18)))
    gap = 9 * sc
    mask = text_mask(scr, "WRONG", cx, cy - gap / 2, sc)
    mask2 = text_mask(scr, "ANSWER", cx, cy + gap / 2, sc)
    base_pts = {(x, y) for y in range(H) for x in range(W) if mask[y][x] is not None or mask2[y][x] is not None}
    pts = list({(x + ox, y + oy) for (x, y) in base_pts for ox in (0, 1) for oy in (0, 1)})
    pts.sort(key=lambda q: (q[1] > cy, q[0]))
    for k in range(70):
        n = int(len(pts) * min(1.0, k / 40))
        for (x, y) in pts[:n]:
            if mx0 <= x < mx1 and my0 <= y < my1:
                mr.clear[y - my0][x - mx0] = 1.0
        mr.render(1.0, 0.55 + 0.08 * math.sin(k * 0.7), MIRROR_REVEAL + 62 + k, tilt=-0.45, grin=1.0, sway=False,
                  text_dark=True, tint=((90, 0, 0), 0.22))
        scr.present()
    time.sleep(0.3)


def animate(win):
    if not sys.stdout.isatty():
        return
    cols, rows = shutil.get_terminal_size((0, 0))
    if cols < 50 or rows < 16:
        return
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    sys.stdout.flush()
    try:
        scr = Screen()
        s = Mirror(scr)
        if win:
            mirror_win(scr, s)
        else:
            mirror_lose(scr, s)
    finally:
        sys.stdout.write("\x1b[0m\x1b[2J\x1b[H\x1b[?1049l\x1b[?25h")
        sys.stdout.flush()


def read_flag():
    try:
        with open(FLAG_PATH) as f:
            return f.read().strip()
    except PermissionError:
        print("can't read /flag, run /challenge/run directly")
        sys.exit(1)


def main():
    print(f"what does {PROG_PATH} print?")
    try:
        answer = input("> ")
    except (EOFError, KeyboardInterrupt):
        print()
        sys.exit(1)
    answer = "".join(answer.split())
    if answer.lower() == "garbage":
        answer = "garbage"
    win = hashlib.sha256(answer.encode()).hexdigest() == EXPECTED_SHA256
    flag = read_flag() if win else None
    try:
        animate(win)
    except KeyboardInterrupt:
        pass
    if win:
        print(f"\x1b[1;92m{flag}\x1b[0m" if sys.stdout.isatty() else flag)
    else:
        print("\x1b[1;91mWrong answer\x1b[0m" if sys.stdout.isatty() else "Wrong answer")
        sys.exit(1)


if __name__ == "__main__":
    main()
