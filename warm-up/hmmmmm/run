def clamp(v):
    return 0 if v < 0 else 248 if v > 248 else int(v) & 0xF8


def rgb(r, g, b):
    return (clamp(r), clamp(g), clamp(b))


def mix(a, b, t):
    return rgb(a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t)


def hsv(h, s=1.0, v=1.0):
    h = (h % 1.0) * 6
    i = int(h)
    f = h - i
    p, q, t = v * (1 - s), v * (1 - s * f), v * (1 - s * (1 - f))
    r, g, b = [(v, t, p), (q, v, p), (p, v, t), (p, q, v), (t, p, v), (v, p, q)][i % 6]
    return rgb(r * 255, g * 255, b * 255)


class Screen:
    def __init__(self):
        cols, rows = shutil.get_terminal_size((100, 30))
        self.W = max(40, min(cols, 170))
        self.rows = max(12, min(rows - 1, 52))
        self.ox = max(0, (cols - self.W) // 2)
        self.oy = max(0, (rows - 1 - self.rows) // 2)
        self.H = self.rows * 2
        self.fb = [[BLACK] * self.W for _ in range(self.H)]
        self.last = time.time()

    def gradient(self, top, bottom):
        H = self.H
        self.fb = [[mix(top, bottom, y / (H - 1))] * self.W for y in range(H)]

    def fill(self, c):
        self.fb = [[c] * self.W for _ in range(self.H)]

    def snapshot(self):
        return [row[:] for row in self.fb]

    def restore(self, snap):
        self.fb = [row[:] for row in snap]

    def px(self, x, y, c):
        x, y = int(x), int(y)
        if 0 <= x < self.W and 0 <= y < self.H:
            self.fb[y][x] = c

    def blend(self, x, y, c, a):
        x, y = int(x), int(y)
        if 0 <= x < self.W and 0 <= y < self.H:
            self.fb[y][x] = mix(self.fb[y][x], c, a)

    def rect(self, x0, y0, x1, y1, c):
        x0, x1 = max(0, int(x0)), min(self.W, int(x1))
        y0, y1 = max(0, int(y0)), min(self.H, int(y1))
        if x0 >= x1:
            return
        seg = [c] * (x1 - x0)
        for y in range(y0, y1):
            self.fb[y][x0:x1] = seg

    def disc(self, cx, cy, r, c):
        for y in range(int(cy - r), int(cy + r) + 1):
            dy = y + 0.5 - cy
            w = r * r - dy * dy
            if w > 0:
                w = math.sqrt(w)
                self.rect(cx - w, y, cx + w, y + 1, c)

    def ring(self, cx, cy, rx, ry, c, th=1.5, a=1.0):
        n = max(16, int((rx + ry) * 4))
        for i in range(n):
            ang = 2 * math.pi * i / n
            ca, sa = math.cos(ang), math.sin(ang)
            d = 0.0
            while d <= th:
                x, y = cx + ca * (rx + d), cy + sa * (ry + d)
                if a >= 1:
                    self.px(x, y, c)
                else:
                    self.blend(x, y, c, a)
                d += 0.8

    def line(self, x0, y0, x1, y1, c, th=1):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        for i in range(n + 1):
            t = i / n
            x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
            if th <= 1:
                self.px(x, y, c)
            else:
                self.rect(x - th / 2, y - th / 2, x + th / 2, y + th / 2, c)

    def tri(self, a, b, c, col):
        minx, maxx = max(0, int(min(a[0], b[0], c[0]))), min(self.W - 1, int(max(a[0], b[0], c[0])) + 1)
        miny, maxy = max(0, int(min(a[1], b[1], c[1]))), min(self.H - 1, int(max(a[1], b[1], c[1])) + 1)
        area = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
        if area == 0:
            return
        for y in range(miny, maxy + 1):
            py = y + 0.5
            row = self.fb[y]
            for x in range(minx, maxx + 1):
                px = x + 0.5
                w0 = (b[0] - a[0]) * (py - a[1]) - (b[1] - a[1]) * (px - a[0])
                w1 = (c[0] - b[0]) * (py - b[1]) - (c[1] - b[1]) * (px - b[0])
                w2 = (a[0] - c[0]) * (py - c[1]) - (a[1] - c[1]) * (px - c[0])
                if (w0 >= 0 and w1 >= 0 and w2 >= 0) or (w0 <= 0 and w1 <= 0 and w2 <= 0):
                    row[x] = col

    def text(self, s, cx, cy, scale, top, bottom, outline=BLACK, slice_dx=None):
        w = len(s) * 6 * scale - scale
        x0 = int(cx - w / 2)
        y0 = int(cy - 7 * scale / 2)
        o = max(1, scale // 2)
        for pass_ in ((0, 1) if outline is not None else (1,)):
            for i, ch in enumerate(s):
                glyph = FONT.get(ch, FONT[" "])
                for r, bits in enumerate(glyph):
                    for k, bit in enumerate(bits):
                        if bit != "1":
                            continue
                        gx = x0 + (i * 6 + k) * scale
                        gy = y0 + r * scale
                        for sy in range(scale):
                            yy = gy + sy
                            dx = slice_dx(yy) if slice_dx else 0
                            if pass_ == 0:
                                self.rect(gx - o + dx, yy - o, gx + scale + o + dx, yy + o + 1, outline)
                            else:
                                col = mix(top, bottom, (r * scale + sy) / (7 * scale))
                                self.rect(gx + dx, yy, gx + scale + dx, yy + 1, col)

    def present(self, dx=0, dy=0, ab=0):
        W, H, fb = self.W, self.H, self.fb
        blank = [BLACK] * W

        def sample(y):
            yy = y - dy
            if not 0 <= yy < H:
                return blank
            r = fb[yy]
            if dx > 0:
                r = [BLACK] * dx + r[: W - dx]
            elif dx < 0:
                r = r[-dx:] + [BLACK] * (-dx)
            if ab:
                r = [(r[max(0, x - ab)][0], r[x][1], r[min(W - 1, x + ab)][2]) for x in range(W)]
            return r

        parts = []
        for row in range(self.rows):
            top, bot = sample(row * 2), sample(row * 2 + 1)
            parts.append("\x1b[%d;%dH" % (row + 1 + self.oy, 1 + self.ox))
            fg = bg = None
            for x in range(W):
                t, b = top[x], bot[x]
                if t == b:
                    if b != bg:
                        parts.append("\x1b[48;2;%d;%d;%dm" % b)
                        bg = b
                    parts.append(" ")
                else:
                    if t != fg:
                        parts.append("\x1b[38;2;%d;%d;%dm" % t)
                        fg = t
                    if b != bg:
                        parts.append("\x1b[48;2;%d;%d;%dm" % b)
                        bg = b
                    parts.append("▀")
        sys.stdout.write("".join(parts))
        sys.stdout.flush()
        now = time.time()
        wait = 1 / FPS - (now - self.last)
        if wait > 0:
            time.sleep(wait)
        self.last = time.time()



class Particles:
    def __init__(self):
        self.items = []

    def burst(self, x, y, n, speed, colors, life=(15, 35), grav=0.15, size=(1, 2)):
        for _ in range(n):
            a = random.uniform(0, 2 * math.pi)
            sp = random.uniform(0.2, 1.0) * speed
            self.items.append([x, y, math.cos(a) * sp, math.sin(a) * sp * 0.8,
                               random.randint(*life), random.choice(colors), grav,
                               random.randint(*size)])

    def add(self, x, y, vx, vy, life, col, grav=0.0, size=1):
        self.items.append([x, y, vx, vy, life, col, grav, size])

    def step(self, scr, shift=0.0):
        keep = []
        for p in self.items:
            p[0] += p[2] - shift
            p[1] += p[3]
            p[3] += p[6]
            p[2] *= 0.97
            p[4] -= 1
            if p[4] > 0:
                keep.append(p)
                s = p[7] if p[4] > 6 else 1
                scr.rect(p[0], p[1], p[0] + s, p[1] + s, p[5])
        self.items = keep


def blend_disc(scr, cx, cy, r, col, a):
    for y in range(int(cy - r), int(cy + r) + 1):
        if not 0 <= y < scr.H:
            continue
        row = scr.fb[y]
        for x in range(int(cx - r), int(cx + r) + 1):
            if 0 <= x < scr.W:
                d = math.hypot(x - cx, y - cy)
                if d < r:
                    row[x] = mix(row[x], col, a * (1 - d / r) ** 2)


def vignette(scr, col, strength, power=2.0):
    W, H = scr.W, scr.H
    cx, cy = W / 2, H / 2
    m = math.hypot(cx, cy)
    for y in range(H):
        row = scr.fb[y]
        dy = (y - cy) ** 2
        for x in range(W):
            k = strength * (math.sqrt((x - cx) ** 2 + dy) / m) ** power
            if k > 0.02:
                row[x] = mix(row[x], col, min(1.0, k))


def frac(v):
    return v - math.floor(v)



def dim(c, k):
    return (min(248, int(c[0] * k)), min(248, int(c[1] * k)), min(248, int(c[2] * k)))


def light_pass(scr, k, skip=None):
    if k >= 0.999:
        return
    scr.fb = [[(int(p[0] * k), int(p[1] * k), int(p[2] * k)) for p in row] for row in scr.fb]


def text_mask(scr, s, cx, cy, sc):
    saved = scr.fb
    scr.fb = [[None] * scr.W for _ in range(scr.H)]
    scr.text(s, cx, cy, sc, WHITE, WHITE, outline=None)
    m = scr.fb
    scr.fb = saved
    return m


def drips_step(scr, drips, col, maxlen):
    for d in drips:
        d[2] = min(maxlen, d[2] + d[3])
        scr.rect(d[0], d[1], d[0] + 1, d[1] + d[2], mix(col, BLACK, 0.3))
        scr.rect(d[0] - 0.5, d[1] + d[2], d[0] + 1.5, d[1] + d[2] + 1.5, col)


BONE = (222, 212, 184)


def draw_hand(scr, bx, by, scale, curl, spread=1.0, ground=None):
    col, dark = BONE, (30, 24, 18)
    wrist = (bx, by)
    segs = []
    segs.append(((bx - scale * 0.12, by + scale * 1.4), (bx - scale * 0.06, by)))
    segs.append(((bx + scale * 0.12, by + scale * 1.4), (bx + scale * 0.07, by)))
    fingers = [(-1.0, 0.6), (-0.42, 0.9), (-0.12, 1.0), (0.18, 0.92), (0.48, 0.72)]
    joints = []
    for i, (ang, ln) in enumerate(fingers):
        a = -math.pi / 2 + ang * spread
        kd = scale * (0.3 if i == 0 else 0.46)
        knuckle = (bx + math.cos(a) * kd, by + math.sin(a) * kd)
        segs.append((wrist, knuckle))
        joints.append(knuckle)
        p = knuckle
        seg_len = scale * ln * 0.3 * (1 - 0.3 * curl)
        bend = (1 if ang < -0.12 else -1 if ang > -0.12 else 0)
        if i == 2:
            bend = 1
        for j in range(3):
            a += curl * 0.42 * bend
            q = (p[0] + math.cos(a) * seg_len, p[1] + math.sin(a) * seg_len)
            segs.append((p, q))
            joints.append(q)
            p = q
            seg_len *= 0.8 * (1 - 0.15 * curl)
    th = max(2, min(6, int(scale * 0.07)))
    for (a, b) in segs:
        scr.line(a[0], a[1], b[0], b[1], dark, th=th + 2)
    for (a, b) in segs:
        scr.line(a[0], a[1], b[0], b[1], col, th=th)
    for j in joints:
        scr.disc(j[0], j[1], th * 0.75, mix(col, WHITE, 0.2))
    scr.disc(wrist[0], wrist[1], th * 1.6, col)
    if ground is not None:
        scr.rect(bx - scale, ground, bx + scale, ground + 2, (40, 30, 20))


def ease(t):
    t = max(0.0, min(1.0, t))
    return t * t * (3 - 2 * t)


class Eye:
    def __init__(self, scr):
        random.seed(909)
        self.scr = scr
        W, H = scr.W, scr.H
        self.W, self.H = W, H
        self.cx, self.cy = W / 2, H * 0.5
        self.rx, self.ry = W * 0.44, H * 0.42
        self.R = min(self.ry * 0.7, self.rx * 0.32)
        cx, cy, rx, ry = self.cx, self.cy, self.rx, self.ry
        self.top, self.bot = [], []
        for x in range(W):
            t = (x + 0.5 - cx) / rx
            k = max(0.0, 1 - t * t) ** 0.75
            self.top.append(cy - ry * k)
            self.bot.append(cy + ry * 0.8 * k)
        self.skin = []
        for y in range(H):
            row = []
            for x in range(W):
                dx, dy = (x - cx) / (W * 0.6), (y - cy) / (H * 0.7)
                d = math.sqrt(dx * dx + dy * dy)
                w = 0.5 + 0.5 * math.sin(y * 0.9 + math.sin(x * 0.08) * 4) * math.sin(x * 0.05 + y * 0.03)
                c = mix((112, 82, 72), (70, 48, 42), w * 0.5)
                row.append(mix(c, (8, 4, 4), min(1.0, d * 0.9)))
            self.skin.append(row)
        self.veins = []
        for _ in range(16):
            side = random.choice([-1, 1])
            a = random.uniform(-0.8, 0.8) + (math.pi if side < 0 else 0)
            x = cx - math.cos(a) * rx * 0.98
            y = cy - math.sin(a) * ry * 0.6
            pts = [(x, y)]
            ang = math.atan2(cy - y, cx - x)
            for j in range(random.randint(5, 9)):
                ang += random.uniform(-0.6, 0.6)
                step = rx * random.uniform(0.04, 0.08)
                x += math.cos(ang) * step
                y += math.sin(ang) * step * 0.7
                pts.append((x, y))
            self.veins.append(pts)
        self.sclera = []
        for y in range(H):
            row = []
            for x in range(W):
                dx, dy = (x + 0.5 - cx) / rx, (y + 0.5 - cy) / ry
                shade = 1 - 0.55 * (dx * dx + dy * dy * 1.6)
                row.append(mix((90, 70, 66), (232, 222, 208), max(0.0, min(1.0, shade))))
            self.sclera.append(row)
        saved = scr.fb
        scr.fb = self.sclera
        for pts in self.veins:
            for i in range(len(pts) - 1):
                scr.line(*pts[i], *pts[i + 1], (176, 52, 52))
        scr.fb = saved
        R = self.R
        self.iris = {}
        for dy in range(-int(R) - 1, int(R) + 2):
            for dx in range(-int(R) - 1, int(R) + 2):
                r = math.hypot(dx + 0.5, dy + 0.5) / R
                if r > 1:
                    continue
                a = math.atan2(dy + 0.5, dx + 0.5)
                b = 0.55 + 0.25 * math.sin(a * 23 + 3 * math.sin(a * 7)) + 0.15 * math.sin(r * 18)
                if r > 0.86:
                    b *= 0.35
                self.iris[(dx, dy)] = max(0.0, min(1.0, b))
        random.seed()

    def render(self, open_, off=(0.0, 0.0), col=(120, 120, 116), pupil=0.38, slit=0.0, light=1.0,
               fill=1.0, fill_col=None, swallow=0.0, vein_k=0.0):
        scr, W, H = self.scr, self.W, self.H
        cx, cy, R = self.cx, self.cy, self.R
        icx, icy = cx + off[0] * R, cy + off[1] * R
        fb = [row[:] for row in self.skin]
        for x in range(W):
            t, b = self.top[x], self.bot[x]
            if b - t < 0.5:
                continue
            mid = t + (b - t) * 0.72
            up = mid + (t - mid) * open_
            lo = mid + (b - mid) * open_
            if lo - up < 0.6:
                if 0 <= int(mid) < H:
                    fb[int(mid)][x] = (20, 8, 8)
                continue
            for y in range(max(0, int(up)), min(H, int(lo) + 1)):
                fb[y][x] = self.sclera[y][x]
            if 0 <= int(up) < H:
                fb[int(up)][x] = (14, 6, 6)
                if x % 2 == 0 and abs(x - cx) < self.rx * 0.9:
                    ln = 2 + int(3 * (1 - abs(x - cx) / self.rx))
                    lean = (x - cx) / self.rx * 2
                    for j in range(1, ln):
                        yy, xx = int(up) - j, int(x + lean * j * 0.5)
                        if 0 <= yy < H and 0 <= xx < W:
                            fb[yy][xx] = (10, 4, 4)
            if 0 <= int(lo) < H:
                fb[int(lo)][x] = (60, 24, 24)
        fc = fill_col or col
        for (dx, dy), bri in self.iris.items():
            x, y = int(icx + dx), int(icy + dy)
            if not (0 <= x < W and 0 <= y < H):
                continue
            t, b = self.top[x], self.bot[x]
            mid = t + (b - t) * 0.72
            if not (mid + (t - mid) * open_ < y < mid + (b - mid) * open_):
                continue
            r = math.hypot(dx + 0.5, dy + 0.5) / R
            c = fc if r <= fill else col
            pix = mix((6, 4, 4), c, bri)
            if slit > 0:
                px_ = pupil * (1 - slit) + 0.13 * slit
                py_ = pupil + (0.88 - pupil) * slit
                if ((dx + 0.5) / (R * px_)) ** 2 + ((dy + 0.5) / (R * py_)) ** 2 <= 1:
                    pix = (2, 2, 2)
            elif r < pupil:
                pix = (2, 2, 2)
            fb[y][x] = pix
        if swallow > 0:
            rr = R * swallow
            for y in range(max(0, int(icy - rr)), min(H, int(icy + rr) + 1)):
                for x in range(max(0, int(icx - rr * 1.3)), min(W, int(icx + rr * 1.3) + 1)):
                    if ((x - icx) / 1.3) ** 2 + (y - icy) ** 2 <= rr * rr:
                        t, b = self.top[x], self.bot[x]
                        mid = t + (b - t) * 0.72
                        if mid + (t - mid) * open_ < y < mid + (b - mid) * open_:
                            fb[y][x] = (2, 0, 0)
        hx, hy = icx - R * 0.32, icy - R * 0.32
        if open_ > 0.3:
            for (ox, oy) in ((0, 0), (1, 0), (0, 1), (1, 1)):
                xx, yy = int(hx + ox), int(hy + oy)
                if 0 <= xx < W and 0 <= yy < H:
                    t, b = self.top[xx], self.bot[xx]
                    mid = t + (b - t) * 0.72
                    if mid + (t - mid) * open_ < yy < mid + (b - mid) * open_:
                        fb[yy][xx] = (240, 240, 236)
        scr.fb = fb
        if vein_k > 0:
            th = 1 + int(vein_k * 2)
            for pts in self.veins:
                for i in range(len(pts) - 1):
                    a, b2 = pts[i], pts[i + 1]
                    xx = int(a[0])
                    if 0 <= xx < W:
                        scr.line(*a, *b2, mix((176, 52, 52), (120, 0, 0), vein_k), th=th)
        if light < 0.999:
            light_pass(scr, light)


EYE_REVEAL = 150


def heartbeat(f):
    k = f % 26
    return 1.0 if k in (0, 1) else (0.6 if k in (5, 6) else 0.0)


def eye_intro(scr, e):
    random.seed(5151)
    for f in range(EYE_REVEAL):
        if f < 28:
            scr.fill(BLACK)
            hb = heartbeat(f)
            if hb:
                vignette(scr, (70, 0, 0), 0.8 * hb)
            scr.present()
            continue
        light = min(0.85, (f - 28) / 30)
        if f < 60:
            open_ = 0.0 if f % 9 else 0.06
        elif f < 100:
            open_ = 0.7 * ease((f - 60) / 40) + 0.03 * math.sin(f * 2.1)
        else:
            open_ = 0.7
        off = (0.0, 0.0)
        if 100 <= f < 132:
            seq = [(-0.55, 0.05), (0.55, -0.05), (-0.4, 0.1), (0.0, 0.0)]
            off = seq[min(3, (f - 100) // 8)]
        pupil = 0.36 + 0.1 * ease((f - 125) / 20) if f > 125 else 0.36
        e.render(open_, off=off, pupil=pupil, light=light)
        hb = heartbeat(f)
        if hb:
            vignette(scr, (40, 0, 0), 0.6 * hb)
        scr.present(1 if f > 135 and f % 5 == 0 else 0, 0, 0)
    random.seed()


def eye_win(scr, e):
    eye_intro(scr, e)
    W, H = scr.W, scr.H
    green = (40, 220, 110)
    for k in range(75):
        fill = min(1.0, 0.36 + k / 8)
        slit = ease((k - 6) / 12)
        open_ = 0.7
        if 26 <= k < 34:
            open_ = 0.7 * abs(1 - (k - 26) / 4)
        if k >= 44:
            open_ = 0.7 * max(0.0, 1 - (k - 44) / 16)
        e.render(open_, col=(120, 120, 116), fill_col=green, fill=fill, pupil=0.46 * (1 - slit) + 0.2 * slit,
                 slit=slit, light=0.85 + 0.15 * min(1.0, k / 10))
        if k >= 50:
            g = min(1.0, (k - 50) / 18)
            for x in range(0, W):
                t, b = e.top[x], e.bot[x]
                if b - t > 1:
                    mid = t + (b - t) * 0.72
                    blend_disc_line = mix(green, WHITE, 0.4)
                    for dy in range(-3, 4):
                        yy = int(mid + dy)
                        if 0 <= yy < H:
                            scr.fb[yy][x] = mix(scr.fb[yy][x], blend_disc_line, g * (1 - abs(dy) / 4))
            blend_disc(scr, W / 2, H * 0.5 + e.ry * 0.3, W * (0.2 + g * 0.6), mix(green, WHITE, 0.5), 0.6 * g)
        scr.present(random.randint(-1, 1) if k < 3 else 0, 0, 1 if k < 2 else 0)
    for k in range(6):
        scr.fill(mix((150, 248, 190), WHITE, k / 5))
        scr.present()
    time.sleep(0.15)


def eye_lose(scr, e):
    eye_intro(scr, e)
    W, H = scr.W, scr.H
    red = (220, 20, 20)
    cracks = []
    for _ in range(10):
        a = random.uniform(0, 2 * math.pi)
        pts = [(W / 2, H / 2)]
        for j in range(9):
            a += random.uniform(-0.45, 0.45)
            r = (j + 1) * max(W, H) / 8
            pts.append((W / 2 + math.cos(a) * r, H / 2 + math.sin(a) * r * 0.6))
        cracks.append(pts)
    drips = [[random.uniform(0, W), 0, 0.0, random.uniform(0.4, 1.4)] for _ in range(26)]
    for k in range(70):
        fill = min(1.0, 0.36 + k / 6)
        pupil = 0.46 + min(0.54, max(0.0, (k - 8) / 14) * 0.54)
        swallow = 0.0 if k < 24 else (k - 24) * 0.12
        vein_k = min(1.0, max(0.0, (k - 6) / 16))
        e.render(0.7 + 0.08 * min(1.0, k / 10), col=(120, 120, 116), fill_col=red, fill=fill, pupil=pupil,
                 swallow=swallow, vein_k=vein_k, light=0.9)
        if k > 20:
            n = min(9, (k - 20) // 2)
            for pts in cracks:
                for j in range(n):
                    scr.line(*pts[j], *pts[j + 1], (150, 136, 126) if k < 40 else (70, 8, 8))
        if k > 30:
            drips_step(scr, drips, (160, 0, 0), H * 1.1)
        if k > 44:
            light_pass(scr, max(0.25, 1 - (k - 44) / 20))
        s = 4 if k < 3 else (2 if 20 < k < 30 else 0)
        scr.present(random.randint(-s, s), random.randint(-s, s), 3 if k < 3 else (1 if 20 < k < 30 else 0))
    sc = max(1, min(int(W * 0.8 / 36), int(H * 0.55 / 18)))
    gap = 9 * sc
    tw = 36 * sc
    tdrips = [[W / 2 + random.uniform(-tw / 2, tw / 2), H * 0.45 + gap / 2 + 3.5 * sc, 0.0, random.uniform(0.2, 0.8)]
              for _ in range(16)]
    for k in range(60):
        scr.fill((6, 0, 0))
        drips_step(scr, drips, (90, 0, 0), H * 1.1)
        red2 = mix((60, 0, 0), (190, 10, 10), min(1.0, k / 10))
        scr.text("WRONG", W / 2, H * 0.45 - gap / 2, sc, red2, mix(red2, BLACK, 0.4), outline=(14, 0, 0))
        scr.text("ANSWER", W / 2, H * 0.45 + gap / 2, sc, red2, mix(red2, BLACK, 0.4), outline=(14, 0, 0))
        if k > 8:
            drips_step(scr, tdrips, mix(red2, BLACK, 0.2), H * 0.35)
        scr.present()
    time.sleep(0.3)


def animate(win):
    if not sys.stdout.isatty():
        return
    cols, rows = shutil.get_terminal_size((0, 0))
    if cols < 50 or rows < 16:
        return
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    sys.stdout.flush()
    try:
        scr = Screen()
        s = Eye(scr)
        if win:
            eye_win(scr, s)
        else:
            eye_lose(scr, s)
    finally:
        sys.stdout.write("\x1b[0m\x1b[2J\x1b[H\x1b[?1049l\x1b[?25h")
        sys.stdout.flush()


def read_flag():
    try:
        with open(FLAG_PATH) as f:
            return f.read().strip()
    except PermissionError:
        print("can't read /flag, run /challenge/run directly")
        sys.exit(1)


def main():
    print(f"what does {PROG_PATH} print?")
    try:
        answer = input("> ")
    except (EOFError, KeyboardInterrupt):
        print()
        sys.exit(1)
    answer = "".join(answer.split())
    if answer.lower() == "garbage":
        answer = "garbage"
    win = hashlib.sha256(answer.encode()).hexdigest() == EXPECTED_SHA256
    flag = read_flag() if win else None
    try:
        animate(win)
    except KeyboardInterrupt:
        pass
    if win:
        print(f"\x1b[1;92m{flag}\x1b[0m" if sys.stdout.isatty() else flag)
    else:
        print("\x1b[1;91mWrong answer\x1b[0m" if sys.stdout.isatty() else "Wrong answer")
        sys.exit(1)


if __name__ == "__main__":
    main()
