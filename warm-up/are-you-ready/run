def clamp(v):
    return 0 if v < 0 else 248 if v > 248 else int(v) & 0xF8


def rgb(r, g, b):
    return (clamp(r), clamp(g), clamp(b))


def mix(a, b, t):
    return rgb(a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t)


def hsv(h, s=1.0, v=1.0):
    h = (h % 1.0) * 6
    i = int(h)
    f = h - i
    p, q, t = v * (1 - s), v * (1 - s * f), v * (1 - s * (1 - f))
    r, g, b = [(v, t, p), (q, v, p), (p, v, t), (p, q, v), (t, p, v), (v, p, q)][i % 6]
    return rgb(r * 255, g * 255, b * 255)


class Screen:
    def __init__(self):
        cols, rows = shutil.get_terminal_size((100, 30))
        self.W = max(40, min(cols, 170))
        self.rows = max(12, min(rows - 1, 52))
        self.ox = max(0, (cols - self.W) // 2)
        self.oy = max(0, (rows - 1 - self.rows) // 2)
        self.H = self.rows * 2
        self.fb = [[BLACK] * self.W for _ in range(self.H)]
        self.last = time.time()

    def gradient(self, top, bottom):
        H = self.H
        self.fb = [[mix(top, bottom, y / (H - 1))] * self.W for y in range(H)]

    def fill(self, c):
        self.fb = [[c] * self.W for _ in range(self.H)]

    def snapshot(self):
        return [row[:] for row in self.fb]

    def restore(self, snap):
        self.fb = [row[:] for row in snap]

    def px(self, x, y, c):
        x, y = int(x), int(y)
        if 0 <= x < self.W and 0 <= y < self.H:
            self.fb[y][x] = c

    def blend(self, x, y, c, a):
        x, y = int(x), int(y)
        if 0 <= x < self.W and 0 <= y < self.H:
            self.fb[y][x] = mix(self.fb[y][x], c, a)

    def rect(self, x0, y0, x1, y1, c):
        x0, x1 = max(0, int(x0)), min(self.W, int(x1))
        y0, y1 = max(0, int(y0)), min(self.H, int(y1))
        if x0 >= x1:
            return
        seg = [c] * (x1 - x0)
        for y in range(y0, y1):
            self.fb[y][x0:x1] = seg

    def disc(self, cx, cy, r, c):
        for y in range(int(cy - r), int(cy + r) + 1):
            dy = y + 0.5 - cy
            w = r * r - dy * dy
            if w > 0:
                w = math.sqrt(w)
                self.rect(cx - w, y, cx + w, y + 1, c)

    def ring(self, cx, cy, rx, ry, c, th=1.5, a=1.0):
        n = max(16, int((rx + ry) * 4))
        for i in range(n):
            ang = 2 * math.pi * i / n
            ca, sa = math.cos(ang), math.sin(ang)
            d = 0.0
            while d <= th:
                x, y = cx + ca * (rx + d), cy + sa * (ry + d)
                if a >= 1:
                    self.px(x, y, c)
                else:
                    self.blend(x, y, c, a)
                d += 0.8

    def line(self, x0, y0, x1, y1, c, th=1):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        for i in range(n + 1):
            t = i / n
            x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
            if th <= 1:
                self.px(x, y, c)
            else:
                self.rect(x - th / 2, y - th / 2, x + th / 2, y + th / 2, c)

    def tri(self, a, b, c, col):
        minx, maxx = max(0, int(min(a[0], b[0], c[0]))), min(self.W - 1, int(max(a[0], b[0], c[0])) + 1)
        miny, maxy = max(0, int(min(a[1], b[1], c[1]))), min(self.H - 1, int(max(a[1], b[1], c[1])) + 1)
        area = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
        if area == 0:
            return
        for y in range(miny, maxy + 1):
            py = y + 0.5
            row = self.fb[y]
            for x in range(minx, maxx + 1):
                px = x + 0.5
                w0 = (b[0] - a[0]) * (py - a[1]) - (b[1] - a[1]) * (px - a[0])
                w1 = (c[0] - b[0]) * (py - b[1]) - (c[1] - b[1]) * (px - b[0])
                w2 = (a[0] - c[0]) * (py - c[1]) - (a[1] - c[1]) * (px - c[0])
                if (w0 >= 0 and w1 >= 0 and w2 >= 0) or (w0 <= 0 and w1 <= 0 and w2 <= 0):
                    row[x] = col

    def text(self, s, cx, cy, scale, top, bottom, outline=BLACK, slice_dx=None):
        w = len(s) * 6 * scale - scale
        x0 = int(cx - w / 2)
        y0 = int(cy - 7 * scale / 2)
        o = max(1, scale // 2)
        for pass_ in ((0, 1) if outline is not None else (1,)):
            for i, ch in enumerate(s):
                glyph = FONT.get(ch, FONT[" "])
                for r, bits in enumerate(glyph):
                    for k, bit in enumerate(bits):
                        if bit != "1":
                            continue
                        gx = x0 + (i * 6 + k) * scale
                        gy = y0 + r * scale
                        for sy in range(scale):
                            yy = gy + sy
                            dx = slice_dx(yy) if slice_dx else 0
                            if pass_ == 0:
                                self.rect(gx - o + dx, yy - o, gx + scale + o + dx, yy + o + 1, outline)
                            else:
                                col = mix(top, bottom, (r * scale + sy) / (7 * scale))
                                self.rect(gx + dx, yy, gx + scale + dx, yy + 1, col)

    def present(self, dx=0, dy=0, ab=0):
        W, H, fb = self.W, self.H, self.fb
        blank = [BLACK] * W

        def sample(y):
            yy = y - dy
            if not 0 <= yy < H:
                return blank
            r = fb[yy]
            if dx > 0:
                r = [BLACK] * dx + r[: W - dx]
            elif dx < 0:
                r = r[-dx:] + [BLACK] * (-dx)
            if ab:
                r = [(r[max(0, x - ab)][0], r[x][1], r[min(W - 1, x + ab)][2]) for x in range(W)]
            return r

        parts = []
        for row in range(self.rows):
            top, bot = sample(row * 2), sample(row * 2 + 1)
            parts.append("\x1b[%d;%dH" % (row + 1 + self.oy, 1 + self.ox))
            fg = bg = None
            for x in range(W):
                t, b = top[x], bot[x]
                if t == b:
                    if b != bg:
                        parts.append("\x1b[48;2;%d;%d;%dm" % b)
                        bg = b
                    parts.append(" ")
                else:
                    if t != fg:
                        parts.append("\x1b[38;2;%d;%d;%dm" % t)
                        fg = t
                    if b != bg:
                        parts.append("\x1b[48;2;%d;%d;%dm" % b)
                        bg = b
                    parts.append("▀")
        sys.stdout.write("".join(parts))
        sys.stdout.flush()
        now = time.time()
        wait = 1 / FPS - (now - self.last)
        if wait > 0:
            time.sleep(wait)
        self.last = time.time()



class Particles:
    def __init__(self):
        self.items = []

    def burst(self, x, y, n, speed, colors, life=(15, 35), grav=0.15, size=(1, 2)):
        for _ in range(n):
            a = random.uniform(0, 2 * math.pi)
            sp = random.uniform(0.2, 1.0) * speed
            self.items.append([x, y, math.cos(a) * sp, math.sin(a) * sp * 0.8,
                               random.randint(*life), random.choice(colors), grav,
                               random.randint(*size)])

    def add(self, x, y, vx, vy, life, col, grav=0.0, size=1):
        self.items.append([x, y, vx, vy, life, col, grav, size])

    def step(self, scr, shift=0.0):
        keep = []
        for p in self.items:
            p[0] += p[2] - shift
            p[1] += p[3]
            p[3] += p[6]
            p[2] *= 0.97
            p[4] -= 1
            if p[4] > 0:
                keep.append(p)
                s = p[7] if p[4] > 6 else 1
                scr.rect(p[0], p[1], p[0] + s, p[1] + s, p[5])
        self.items = keep


def blend_disc(scr, cx, cy, r, col, a):
    for y in range(int(cy - r), int(cy + r) + 1):
        if not 0 <= y < scr.H:
            continue
        row = scr.fb[y]
        for x in range(int(cx - r), int(cx + r) + 1):
            if 0 <= x < scr.W:
                d = math.hypot(x - cx, y - cy)
                if d < r:
                    row[x] = mix(row[x], col, a * (1 - d / r) ** 2)


def vignette(scr, col, strength, power=2.0):
    W, H = scr.W, scr.H
    cx, cy = W / 2, H / 2
    m = math.hypot(cx, cy)
    for y in range(H):
        row = scr.fb[y]
        dy = (y - cy) ** 2
        for x in range(W):
            k = strength * (math.sqrt((x - cx) ** 2 + dy) / m) ** power
            if k > 0.02:
                row[x] = mix(row[x], col, min(1.0, k))


def frac(v):
    return v - math.floor(v)



def dim(c, k):
    return (min(248, int(c[0] * k)), min(248, int(c[1] * k)), min(248, int(c[2] * k)))


def light_pass(scr, k, skip=None):
    if k >= 0.999:
        return
    scr.fb = [[(int(p[0] * k), int(p[1] * k), int(p[2] * k)) for p in row] for row in scr.fb]


def text_mask(scr, s, cx, cy, sc):
    saved = scr.fb
    scr.fb = [[None] * scr.W for _ in range(scr.H)]
    scr.text(s, cx, cy, sc, WHITE, WHITE, outline=None)
    m = scr.fb
    scr.fb = saved
    return m


def drips_step(scr, drips, col, maxlen):
    for d in drips:
        d[2] = min(maxlen, d[2] + d[3])
        scr.rect(d[0], d[1], d[0] + 1, d[1] + d[2], mix(col, BLACK, 0.3))
        scr.rect(d[0] - 0.5, d[1] + d[2], d[0] + 1.5, d[1] + d[2] + 1.5, col)


BONE = (222, 212, 184)


def draw_hand(scr, bx, by, scale, curl, spread=1.0, ground=None):
    col, dark = BONE, (30, 24, 18)
    wrist = (bx, by)
    segs = []
    segs.append(((bx - scale * 0.12, by + scale * 1.4), (bx - scale * 0.06, by)))
    segs.append(((bx + scale * 0.12, by + scale * 1.4), (bx + scale * 0.07, by)))
    fingers = [(-1.0, 0.6), (-0.42, 0.9), (-0.12, 1.0), (0.18, 0.92), (0.48, 0.72)]
    joints = []
    for i, (ang, ln) in enumerate(fingers):
        a = -math.pi / 2 + ang * spread
        kd = scale * (0.3 if i == 0 else 0.46)
        knuckle = (bx + math.cos(a) * kd, by + math.sin(a) * kd)
        segs.append((wrist, knuckle))
        joints.append(knuckle)
        p = knuckle
        seg_len = scale * ln * 0.3 * (1 - 0.3 * curl)
        bend = (1 if ang < -0.12 else -1 if ang > -0.12 else 0)
        if i == 2:
            bend = 1
        for j in range(3):
            a += curl * 0.42 * bend
            q = (p[0] + math.cos(a) * seg_len, p[1] + math.sin(a) * seg_len)
            segs.append((p, q))
            joints.append(q)
            p = q
            seg_len *= 0.8 * (1 - 0.15 * curl)
    th = max(2, min(6, int(scale * 0.07)))
    for (a, b) in segs:
        scr.line(a[0], a[1], b[0], b[1], dark, th=th + 2)
    for (a, b) in segs:
        scr.line(a[0], a[1], b[0], b[1], col, th=th)
    for j in joints:
        scr.disc(j[0], j[1], th * 0.75, mix(col, WHITE, 0.2))
    scr.disc(wrist[0], wrist[1], th * 1.6, col)
    if ground is not None:
        scr.rect(bx - scale, ground, bx + scale, ground + 2, (40, 30, 20))


class Seance:
    def __init__(self, scr):
        random.seed(777)
        self.scr = scr
        W, H = scr.W, scr.H
        self.W, self.H = W, H
        fb = []
        for y in range(H):
            row = []
            for x in range(W):
                g = math.sin(y * 0.55 + math.sin(x * 0.045) * 3 + math.sin(x * 0.011) * 5)
                row.append(mix((34, 18, 10), (64, 36, 20), 0.5 + 0.5 * g))
            fb.append(row)
        scr.fb = fb
        bx0, by0, bx1, by1 = W * 0.1, H * 0.3, W * 0.9, H * 0.97
        self.board = (bx0, by0, bx1, by1)
        r = H * 0.08
        for y in range(int(by0), int(by1)):
            for x in range(int(bx0), int(bx1)):
                dx = max(0, bx0 + r - x, x - (bx1 - r))
                dy = max(0, by0 + r - y, y - (by1 - r))
                if dx * dx + dy * dy > r * r:
                    continue
                edge = min(x - bx0, bx1 - x, y - by0, by1 - y)
                burn = max(0.0, 1 - edge / (H * 0.09))
                n = math.sin(x * 0.3 + y * 0.17) * math.sin(x * 0.07 - y * 0.21)
                c = mix((170, 140, 92), (130, 100, 62), 0.5 + 0.5 * n)
                scr.fb[y][x] = mix(c, (40, 24, 12), burn ** 1.5)
        ink = (46, 26, 12)
        inset = H * 0.025
        for (ax, ay, bx, by) in ((bx0 + inset, by0 + inset, bx1 - inset, by0 + inset), (bx0 + inset, by1 - inset, bx1 - inset, by1 - inset)):
            scr.line(ax, ay, bx, by, ink)
        scale = 1 if W < 150 else 2
        self.letters = {}
        self.put_word("YES", W * 0.27, H * 0.4, scale, ink)
        self.put_word("NO", W * 0.73, H * 0.4, scale, ink)
        scr.disc(W * 0.17, H * 0.4, H * 0.035, ink)
        for k in range(8):
            a = k * math.pi / 4
            scr.line(W * 0.17 + math.cos(a) * H * 0.045, H * 0.4 + math.sin(a) * H * 0.045,
                     W * 0.17 + math.cos(a) * H * 0.07, H * 0.4 + math.sin(a) * H * 0.07, ink)
        scr.disc(W * 0.83, H * 0.4, H * 0.04, ink)
        scr.disc(W * 0.83 + H * 0.018, H * 0.395, H * 0.035, mix((170, 140, 92), (130, 100, 62), 0.5))
        cx = W * 0.5
        for row_i, (word, ry) in enumerate((("ACDEFGILMN", 0.56), ("OPRSTUVWXY", 0.7))):
            n = len(word)
            for i, ch in enumerate(word):
                t = (i - (n - 1) / 2) / ((n - 1) / 2)
                lx = cx + t * W * (0.29 - row_i * 0.02)
                ly = H * ry + (t * t) * H * (-0.07)
                scr.text(ch, lx, ly, scale, ink, ink, outline=None)
                self.letters[ch] = (lx, ly)
        self.put_word("FAREWELL", cx, H * 0.86, scale, ink)
        self.candles = [(W * 0.22, H * 0.17), (W * 0.5, H * 0.1), (W * 0.78, H * 0.17)]
        cw, ch_ = max(2, W * 0.022), H * 0.13
        for (x, y) in self.candles:
            scr.rect(x - cw, y, x + cw, y + ch_, (196, 186, 156))
            scr.rect(x - cw, y, x - cw + 1, y + ch_, (150, 140, 112))
            scr.rect(x + cw - 1, y, x + cw, y + ch_, (226, 218, 190))
            for k in range(3):
                dx = x - cw + (k + 0.5) * cw * 2 / 3
                scr.rect(dx, y, dx + 1, y + random.uniform(2, ch_ * 0.6), (216, 206, 176))
            scr.rect(x - cw - 2, y + ch_, x + cw + 2, y + ch_ + 2, (80, 70, 60))
            scr.line(x, y - 2, x, y, (20, 16, 12))
        self.base = scr.snapshot()
        self.maps = []
        R2 = (H * 0.55) ** 2
        for (fx, fy) in self.candles:
            fy -= H * 0.04
            self.maps.append([[1.0 / (1.0 + ((x - fx) ** 2 + ((y - fy) * 1.2) ** 2) / R2 * 3.0) for x in range(W)] for y in range(H)])
        self.center = (cx, H * 0.6)
        random.seed()

    def put_word(self, s, x, y, sc, ink):
        self.scr.text(s, x, y, sc, ink, ink, outline=None)
        self.letters[s] = (x, y)

    def render(self, flames, amb=0.06, tint=(1.0, 0.78, 0.5), lean=0.0, f=0, flame_col=None):
        scr, W, H = self.scr, self.W, self.H
        m0, m1, m2 = self.maps
        i0, i1, i2 = [fl for fl in flames]
        t0, t1, t2 = tint
        out = []
        for y in range(H):
            brow, r0, r1, r2 = self.base[y], m0[y], m1[y], m2[y]
            o = []
            for x in range(W):
                k = (amb + i0 * r0[x] + i1 * r1[x] + i2 * r2[x]) * 1.25
                p = brow[x]
                o.append((min(248, int(p[0] * k * t0)), min(248, int(p[1] * k * t1)), min(248, int(p[2] * k * t2))))
            out.append(o)
        scr.fb = out
        for j, (x, y) in enumerate(self.candles):
            it = flames[j]
            if it <= 0.02:
                continue
            fl_h = H * 0.06 * (0.8 + 0.4 * it) * (1 + 0.12 * math.sin(f * 1.3 + j * 2))
            tip_dx = lean * H * 0.05 + math.sin(f * 0.9 + j) * 1.2
            col = flame_col or (248, 200, 90)
            core = mix(col, WHITE, 0.6)
            blend_disc(scr, x, y - fl_h * 0.5, H * 0.18 * it, col, 0.25 * it)
            scr.tri((x - fl_h * 0.25, y - 1), (x + fl_h * 0.25, y - 1), (x + tip_dx, y - 2 - fl_h), col)
            scr.disc(x, y - fl_h * 0.25, max(1, fl_h * 0.22), core)

    def planchette(self, wx, wy, tint=1.0):
        scr, H = self.scr, self.H
        s = H * 0.09
        bx, by = wx, wy + s * 0.75
        body = dim((150, 112, 70), tint)
        edge = dim((60, 40, 22), tint)
        for y in range(int(by - s * 1.9), int(by + s) + 1):
            for x in range(int(bx - s * 1.1), int(bx + s * 1.1) + 1):
                dx, dy = x + 0.5 - bx, y + 0.5 - by
                inside = dx * dx + dy * dy <= s * s or (dy < 0 and abs(dx) <= s * (1 + dy / (s * 1.9)) * 0.95)
                if not inside:
                    continue
                wdx, wdy = x + 0.5 - wx, y + 0.5 - wy
                wd = wdx * wdx + wdy * wdy
                if wd <= (s * 0.32) ** 2:
                    continue
                if wd <= (s * 0.42) ** 2:
                    scr.px(x, y, edge)
                    continue
                d = dx * dx + dy * dy
                outer = d > (s - 1.2) ** 2 and dy >= 0
                if outer or (dy < 0 and abs(dx) > s * (1 + dy / (s * 1.9)) * 0.95 - 1.2):
                    scr.px(x, y, edge)
                else:
                    scr.px(x, y, mix(body, WHITE, max(0.0, -dx / s) * 0.15))


def ease(t):
    t = max(0.0, min(1.0, t))
    return t * t * (3 - 2 * t)


SEANCE_REVEAL = 150


def seance_path(sn):
    pts = [sn.center] + [sn.letters[c] for c in "WAIT"] + [sn.center]
    plan = []
    for i in range(len(pts) - 1):
        a, b = pts[i], pts[i + 1]
        for k in range(18):
            t = ease(k / 17)
            plan.append((a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t))
        for k in range(8):
            plan.append(b)
    return plan


def seance_intro(scr, sn):
    random.seed(4141)
    plan = seance_path(sn)
    for f in range(SEANCE_REVEAL):
        base = 0.85 + 0.1 * math.sin(f * 0.37) + 0.05 * math.sin(f * 1.9)
        lean = 0.0
        if f > 20:
            lean = min(1.0, (f - 20) / 40)
        fl = [base, base * 0.95 + 0.05 * math.sin(f), base]
        if f > 130:
            fl = [x * (0.55 + 0.25 * math.sin(f * 3.3)) for x in fl]
        sn.render(fl, lean=-lean * 0.6 if f % 40 < 20 else lean * 0.6, f=f)
        k = f - 12
        if 0 <= k < len(plan):
            wx, wy = plan[k]
        else:
            wx, wy = sn.center
        sn.planchette(wx, wy)
        scr.present()
    random.seed()


def seance_win(scr, sn):
    seance_intro(scr, sn)
    W, H = scr.W, scr.H
    a, b = sn.center, sn.letters["YES"]
    p = Particles()
    green = (60, 248, 140)
    for k in range(80):
        f = SEANCE_REVEAL + k
        t = ease(k / 22)
        wx, wy = a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t
        g = min(1.0, max(0.0, (k - 18) / 10))
        fl = [0.9 + 0.3 * g] * 3
        col = mix((248, 200, 90), green, g)
        sn.render(fl, f=f, tint=(1.0 - 0.5 * g, 0.78 + 0.2 * g, 0.5 + 0.2 * g), flame_col=col, amb=0.06 + 0.1 * g)
        sn.planchette(wx, wy)
        if k > 26:
            for _ in range(3):
                p.add(sn.center[0] + random.uniform(-W * 0.12, W * 0.12), sn.center[1] + random.uniform(-4, 4),
                      random.uniform(-0.2, 0.2), -random.uniform(0.3, 0.8), random.randint(30, 50),
                      mix((150, 170, 160), green, random.random() * 0.5), -0.004, 1)
            fa = min(1.0, (k - 26) / 25)
            fx, fy = sn.center[0], H * 0.32
            blend_disc(scr, fx, fy, H * 0.3, (170, 200, 185), 0.35 * fa)
            for ex in (-1, 1):
                blend_disc(scr, fx + ex * H * 0.09, fy - H * 0.03, H * 0.06, BLACK, 0.5 * fa)
            blend_disc(scr, fx, fy + H * 0.1, H * 0.05, BLACK, 0.4 * fa)
        if k > 58:
            blend_disc(scr, W / 2, H * 0.35, H * (0.3 + (k - 58) * 0.12), mix(green, WHITE, 0.5), min(1.0, (k - 58) * 0.06))
        p.step(scr)
        scr.present(random.randint(-1, 1) if 18 <= k < 22 else 0, 0, 0)
    for k in range(6):
        scr.fill(mix(green, WHITE, 0.4 + k / 9))
        scr.present()
    time.sleep(0.15)


def seance_lose(scr, sn):
    seance_intro(scr, sn)
    W, H = scr.W, scr.H
    a, b = sn.center, sn.letters["NO"]
    p = Particles()
    for k in range(6):
        t = ease(k / 4)
        wx, wy = a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t
        sn.render([1.0, 1.0, 1.0], f=SEANCE_REVEAL + k, lean=1.5)
        sn.planchette(wx, wy)
        scr.present(random.randint(-3, 3), random.randint(-2, 2), 2)
    for (x, y) in sn.candles:
        for _ in range(12):
            p.add(x, y - 2, random.uniform(-0.3, 0.3), -random.uniform(0.3, 0.9), random.randint(25, 45), (90, 90, 96), -0.01, 1)
    for k in range(24):
        sn.render([0, 0, 0], amb=0.05 * max(0.0, 1 - k / 8) + 0.008, f=0)
        sn.planchette(b[0], b[1], tint=max(0.1, 0.6 - k * 0.05))
        p.step(scr)
        scr.present()
    for k in range(26):
        cold = min(1.0, k / 3)
        sn.render([0, 0, 0], amb=0.05 + 0.08 * cold, tint=(0.55, 0.7, 1.0), f=0)
        sn.planchette(b[0], b[1], tint=0.4)
        rise = min(1.0, k / 4)
        for side, hx in ((-1, W * 0.2), (1, W * 0.8)):
            hy = H * (1.2 - 0.55 * rise)
            draw_hand(scr, hx, hy, H * 0.33, 0.25 if k > 4 else 0.0, spread=1.25)
        p.step(scr)
        s = 6 if k in (4, 5, 6) else (1 if k > 6 else 0)
        scr.present(random.randint(-s, s), random.randint(-s, s), 3 if k in (4, 5) else 0)
    for k in range(10):
        sn.render([0, 0, 0], amb=0.1, tint=(0.55, 0.7, 1.0), f=0)
        size = H * (0.25 + 1.6 * (k / 9) ** 2)
        fx, fy = W / 2, H * 0.45
        blend_disc(scr, fx, fy, size, (200, 210, 220), 0.85)
        for ex in (-1, 1):
            scr.disc(fx + ex * size * 0.3, fy - size * 0.12, size * 0.13, BLACK)
        for y in range(int(fy + size * 0.12), int(fy + size * (0.55 + 0.1 * k / 9))):
            w = size * 0.13 * math.sin(math.pi * (y - fy - size * 0.12) / (size * (0.43 + 0.1 * k / 9)))
            scr.rect(fx - w, y, fx + w, y + 1, (8, 0, 0))
        s = 2 + k
        scr.present(random.randint(-s, s), random.randint(-s, s), 1 + k // 2)
    for k in range(10):
        scr.fill(BLACK)
        scr.present()
    sc = max(1, min(int((sn.board[2] - sn.board[0]) * 0.8 / 36), int(H * 0.45 / 18)))
    gap = 9 * sc
    cy = H * 0.6
    for k in range(64):
        sn.render([0, 0, 0], amb=0.035, tint=(1.0, 0.6, 0.4), f=0)
        sn.planchette(b[0], b[1], tint=0.25)
        burn = min(1.0, k / 16)
        ember = mix((60, 10, 0), (248, 110 + int(60 * math.sin(k * 0.5)), 20), burn)
        for i, w in enumerate(("WRONG", "ANSWER")):
            scr.text(w, W / 2, cy + (i - 0.5) * gap, sc, mix(ember, (248, 220, 120), 0.3), ember, outline=(14, 6, 2))
        blend_disc(scr, W / 2, cy, W * 0.4, (248, 90, 20), 0.12 * burn)
        if k % 2 == 0:
            p.add(W / 2 + random.uniform(-W * 0.3, W * 0.3), cy + random.uniform(-gap, gap), random.uniform(-0.2, 0.2),
                  -random.uniform(0.3, 0.8), random.randint(20, 40), random.choice([(90, 90, 96), (248, 140, 40)]), -0.01, 1)
        p.step(scr)
        scr.present(random.randint(-1, 1) if k < 6 else 0, 0, 0)
    time.sleep(0.3)


def animate(win):
    if not sys.stdout.isatty():
        return
    cols, rows = shutil.get_terminal_size((0, 0))
    if cols < 50 or rows < 16:
        return
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")
    sys.stdout.flush()
    try:
        scr = Screen()
        s = Seance(scr)
        if win:
            seance_win(scr, s)
        else:
            seance_lose(scr, s)
    finally:
        sys.stdout.write("\x1b[0m\x1b[2J\x1b[H\x1b[?1049l\x1b[?25h")
        sys.stdout.flush()


def read_flag():
    try:
        with open(FLAG_PATH) as f:
            return f.read().strip()
    except PermissionError:
        print("can't read /flag, run /challenge/run directly")
        sys.exit(1)


def main():
    print(f"what does {PROG_PATH} print?")
    try:
        answer = input("> ")
    except (EOFError, KeyboardInterrupt):
        print()
        sys.exit(1)
    answer = "".join(answer.split())
    if answer.lower() == "garbage":
        answer = "garbage"
    win = hashlib.sha256(answer.encode()).hexdigest() == EXPECTED_SHA256
    flag = read_flag() if win else None
    try:
        animate(win)
    except KeyboardInterrupt:
        pass
    if win:
        print(f"\x1b[1;92m{flag}\x1b[0m" if sys.stdout.isatty() else flag)
    else:
        print("\x1b[1;91mWrong answer\x1b[0m" if sys.stdout.isatty() else "Wrong answer")
        sys.exit(1)


if __name__ == "__main__":
    main()
